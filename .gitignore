# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets: API keys live in environment variables or a local .env, never in git
.env
.env.*

# Raw Scorecard downloads are large (~360 MB). Rebuild them with:
#   python data/download_data.py
# The manifest (URLs + SHA-256 checksums) IS committed so anyone can verify they have the same release.
data/raw/*
!data/raw/MANIFEST.json

# OS junk
.DS_Store
Thumbs.db

# Test runs with the fake echo model, and draft outputs made before the crosswalk is final
runs/test/
data/processed/*_DRAFT.csv

# Intermediate HTML from prereg/build_filing.py (the PDF is what gets filed)
prereg/preregistration.html
